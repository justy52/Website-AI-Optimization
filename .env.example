# Copy this file to .env.local and fill in real values.
# Values are intentionally blank so only variable names are committed.
# Never commit .env.local or any file containing real secrets.
# See ENVIRONMENT-SETUP.md for full explanations and rollout phases.

# --- Runtime ---
APP_ENV=
NODE_ENV=

# --- Database (Neon) ---
# Restricted virelantic_runtime login, never an owner or Console-created role.
DATABASE_URL=
# Optional direct URL for the SAME restricted runtime login. No owner secret here.
DATABASE_URL_UNPOOLED=

# --- Auth (self-hosted Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Production defaults closed. Enroll only approved exact emails temporarily,
# behind deployment protection, then close again. Neither setting grants admin.
AUTH_SIGNUP_ENABLED=
AUTH_ENROLLMENT_EMAILS=

# --- Encryption for stored integration secrets ---
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=
CREDENTIAL_ENCRYPTION_KEY_RING=

# --- Phase 3: governed PREPARE AI via Vercel AI Gateway ---
AGENT_PROVIDER=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=

# --- Object storage (Vercel Blob, private) ---
BLOB_READ_WRITE_TOKEN=

# --- Phase 4: read integrations (leave blank until then) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PAGESPEED_API_KEY=
# Optional. Enables Google Business Profile, review and listing-consistency audit checks (Places API (New)).
GOOGLE_PLACES_API_KEY=
# Optional. Enables the referring-domains audit check (DataForSEO Backlinks API). Both are required.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CRON_SECRET=
# Separate read-only production readiness credential; never reuse CRON_SECRET.
MONITORING_SECRET=

# --- Phase 4: observed AI visibility surfaces (roll out in this order) ---
PERPLEXITY_API_KEY=
AI_VISIBILITY_PROVIDER=perplexity
GEMINI_API_KEY=

# QA sandbox only; production/local execution always denied
QA_EXECUTE_ENABLED=false

# Service-business payments. Keep disabled until deployment and owner launch review.
SERVICE_PAYMENTS_MODE=disabled
# Preferred isolated test configuration. Test credentials must never be in production.
SERVICE_PAYMENTS_TEST_WORKSPACE_ID=
SERVICE_PAYMENTS_TEST_BASE_URL=
STRIPE_SERVICE_TEST_ACCOUNT_ID=
STRIPE_SERVICE_TEST_SECRET_KEY=
STRIPE_SERVICE_TEST_WEBHOOK_SECRET=
# Legacy test-only aliases. Leave blank when using the preferred names above.
SERVICE_PAYMENTS_WORKSPACE_ID=
SERVICE_PAYMENTS_BASE_URL=
STRIPE_SERVICE_ACCOUNT_ID=
STRIPE_SERVICE_SECRET_KEY=
STRIPE_SERVICE_WEBHOOK_SECRET=

# Production-only configuration. Blank values DO NOT enable live payments.
# Requires NODE_ENV=production, APP_ENV=production, and VERCEL_ENV=production on Vercel.
SERVICE_PAYMENTS_LIVE_ACTIVATION=
SERVICE_PAYMENTS_LIVE_COLLECTION_ENABLED=false
SERVICE_PAYMENTS_LIVE_APPROVAL_REFERENCE=
SERVICE_PAYMENTS_LIVE_LEGAL_SELLER=
SERVICE_PAYMENTS_LIVE_TERMS_VERSION=
SERVICE_PAYMENTS_LIVE_WORKSPACE_ID=
SERVICE_PAYMENTS_LIVE_BASE_URL=
STRIPE_SERVICE_LIVE_ACCOUNT_ID=
STRIPE_SERVICE_LIVE_SECRET_KEY=
STRIPE_SERVICE_LIVE_WEBHOOK_SECRET=
STRIPE_SERVICE_LIVE_WEBHOOK_ENDPOINT_ID=

# Transactional email through Resend (optional). With RESEND_API_KEY and
# EMAIL_FROM set, the sign-in page offers password reset. EMAIL_FROM must use a
# domain verified in Resend, for example: Virelantic <notifications@virelantic.com>
# OWNER_NOTIFICATION_EMAIL receives new audit request and payment-problem alerts.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_NOTIFICATION_EMAIL=
