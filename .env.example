# Copy this file to .env.local and fill in real values.
# Values are intentionally blank so only variable names are committed.
# Never commit .env.local or any file containing real secrets.
# See ENVIRONMENT-SETUP.md for full explanations and rollout phases.

# --- Runtime ---
APP_ENV=
NODE_ENV=

# --- Database (Neon) ---
# Restricted virelantic_runtime login, never an owner or Console-created role.
DATABASE_URL=
# Optional direct URL for the SAME restricted runtime login. No owner secret here.
DATABASE_URL_UNPOOLED=

# --- Auth (self-hosted Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Encryption for stored integration secrets ---
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=
CREDENTIAL_ENCRYPTION_KEY_RING=

# --- Phase 3: governed PREPARE AI via Vercel AI Gateway ---
AGENT_PROVIDER=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# --- Object storage (Vercel Blob, private) ---
BLOB_READ_WRITE_TOKEN=

# --- Phase 4: read integrations (leave blank until then) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CRON_SECRET=

# --- Phase 4: observed AI visibility surfaces (roll out in this order) ---
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# QA sandbox only; production/local execution always denied
QA_EXECUTE_ENABLED=false

# Service-business payment pilot. Never use live keys; production is blocked.
SERVICE_PAYMENTS_MODE=disabled
SERVICE_PAYMENTS_WORKSPACE_ID=
SERVICE_PAYMENTS_BASE_URL=
STRIPE_SERVICE_ACCOUNT_ID=
STRIPE_SERVICE_SECRET_KEY=
STRIPE_SERVICE_WEBHOOK_SECRET=
